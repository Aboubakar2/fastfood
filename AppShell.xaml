<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="fastfood.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:fastfood"
    xmlns:pages="clr-namespace:fastfood.Pages"
    Shell.FlyoutBackgroundColor="#f5deb3"
    Shell.FlyoutBehavior="Locked"
    Shell.FlyoutWidth="170"
    Title="fastfood">


    <ShellContent
        Title="Home"
        Icon="ic_home_ff.png"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Fournisseurs"
        Icon="ic_provider_ff.png"
        ContentTemplate="{DataTemplate pages:ProviderPage}"/>

    <ShellContent
        Title="Commandes"
        Icon="icon_order.png"
        ContentTemplate="{DataTemplate pages:OrdersPage}"
        Route="OrdersPage"/>

    <ShellContent
        Title="Produits"
        Icon="ic_food_ff.png"
        ContentTemplate="{DataTemplate pages:ProductsPage}"
        Route="ProductsPage"/>

    <ShellContent
        Title="Derogation"
        Icon="ic_users_ff.png"
        ContentTemplate="{DataTemplate pages:ExemptionPage}"
        Route="ExemptionPage"/>
        
    <Shell.FlyoutFooter>
        <Image
            Source="ic_logout_ff.png"
            HorizontalOptions="Start"
            WidthRequest="20"
            Margin="15,0,0,25"
            
            />
    </Shell.FlyoutFooter>

</Shell>
