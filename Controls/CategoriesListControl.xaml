<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fastfood.Controls.CategoriesListControl"
             xmlns:data="clr-namespace:fastfood.Data"
             xmlns:models="clr-namespace:fastfood.Models"
             xmlns:vm="clr-namespace:fastfood.ViewModels"
             xmlns:controls="clr-namespace:fastfood.Controls"
             x:Name="this">



    <CollectionView Grid.Row="1" BindingContext="{x:Reference this}" ItemsSource="{ Binding Categories }" >
        <CollectionView.ItemsLayout>
            <LinearItemsLayout ItemSpacing="10" Orientation="Horizontal"/>
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:MenuCategoryModel">
                <Border Padding="20,10"  StrokeShape="RoundRectangle 10" BackgroundColor="LightGoldenrodYellow"
                                StrokeThickness="0">
                    <HorizontalStackLayout Spacing="5">
                        <Image HeightRequest="25" 
                                       Source="{ Binding Icon }" 
                                       VerticalOptions="Center"
                                       WidthRequest="25"
                                       />
                        <Label Text="{Binding Name}"
                                       FontSize="16" 
                                       VerticalOptions="Center"
                                       TextColor="Maroon">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="TextColor" Value="White"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type controls:CategoriesListControl}},Path=SelectCategoryCommand}"
                                                      CommandParameter="{Binding .}"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="Maroon"/>
                        </DataTrigger>
                    </Border.Triggers>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>


</ContentView>
