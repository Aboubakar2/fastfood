<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fastfood.Pages.MainPage"
             xmlns:data="clr-namespace:fastfood.Data"
             xmlns:models="clr-namespace:fastfood.Models"
             xmlns:vm="clr-namespace:fastfood.ViewModels"
             xmlns:controls="clr-namespace:fastfood.Controls"
             x:DataType="vm:HomeViewModel"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label" x:Key="lbl">
                <Setter Property="TextColor" Value="Black"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Définir les colonnes -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.74*" />
            <!-- Produits -->
            <ColumnDefinition Width="0.26*" />
            <!-- Panier -->
        </Grid.ColumnDefinitions>

        <!-- Section Produits -->
        <Grid Grid.Column="0" RowDefinitions="Auto , Auto,*" BackgroundColor="WhiteSmoke" RowSpacing="10 " >

            <controls:CategoriesListControl Grid.Row="1" Categories="{Binding Categories}" OnCategorySelected="CategoriesListControl_OnCategorySelected" MaximumHeightRequest="50"/>

            <Grid Grid.Row="2">

                <controls:MenuItemsListControl Items="{Binding MenuItems}" OnSelectItem="MenuItemsListControl_OnSelectItem"/>

                <BoxView HorizontalOptions="Fill"
                         IsVisible="{Binding IsLoading}"
                         Opacity="0.5"
                         VerticalOptions="Fill"
                         Color="Black"/>

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   HeightRequest="30"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   WidthRequest="30"
                                   Color="Maroon"/>
            </Grid>
        </Grid>
 

        <!-- Section Panier -->
        <Grid Grid.Column="1"  BackgroundColor="Wheat" RowDefinitions="Auto,*, Auto" Padding="0,10">
            <VerticalStackLayout Grid.Row="0" Spacing="5" Padding="10,0">
                <Label Text="Commande Actuelle"  TextColor="Black" FontAttributes="Bold" FontSize="20"/>
            </VerticalStackLayout> 
            
            <Grid Padding="10" Grid.Row="1" >
                <CollectionView Grid.Row="1" ItemsSource="{Binding CartItems}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="2" Orientation="Vertical"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CartModel">
                        <Grid>
                            <Border Padding="5" BackgroundColor="GhostWhite">
                                <Border.StrokeShape>
                                    <RoundRectangle  CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="70,*">
                                    <Border Grid.Column="0" HeightRequest="60" BackgroundColor="LightGray" WidthRequest="60" StrokeShape="RoundRectangle 10">
                                        <Image Source="{Binding Icon}" Aspect="AspectFill" HeightRequest="60" WidthRequest="60" BackgroundColor="LightGray"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                                        <Label Text="{Binding Name}" TextColor="Black" FontSize="12" FontAttributes="Bold" />
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Label Grid.Column="0" Text="{Binding Price,StringFormat='{0} FCFA'}" TextColor="Maroon" FontAttributes="Bold" FontSize="12"/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,2*,*" WidthRequest="90" HorizontalOptions="End">

                                                <ImageButton Grid.Column="0" BackgroundColor="Maroon" CornerRadius="5"
                                                    MinimumWidthRequest="20" MinimumHeightRequest="20" Source="minus_color.png"
                                                    Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:HomeViewModel}},Path=DecreaseQuantityCommand}"
                                                    CommandParameter="{Binding .}"/>


                                                <Label Grid.Column="1" Padding="5" BackgroundColor="Wheat" FontSize="12" HeightRequest="25"
                                                    WidthRequest="30" HorizontalOptions="Center" HorizontalTextAlignment="Center" 
                                                    Text="{Binding Quantity}" TextColor="Maroon" FontAttributes="Bold"/>

                                                <ImageButton Grid.Column="2" BackgroundColor="Maroon" CornerRadius="5"
                                                        MinimumWidthRequest="20" MinimumHeightRequest="20" Source="plus_color.png"
                                                        Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:HomeViewModel}},Path=IncreaseQuantityCommand}"
                                                        CommandParameter="{Binding .}"/>
                                                </Grid>
                                            </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                                <ImageButton BackgroundColor="Red"
                                         CornerRadius="5"
                                         MinimumHeightRequest="20"
                                         MinimumWidthRequest="20"
                                         HorizontalOptions="End"
                                         VerticalOptions="Start"
                                         Source="dele.png"
                                         Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:HomeViewModel}},Path=RemoveFromCartCommand}"
                                         CommandParameter="{Binding .}"/>


                            </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>  

            </Grid>
             
            <!--  facture -->
            <VerticalStackLayout Grid.Row="2">
                <Border Padding="10" BackgroundColor="White" StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                    <Border.Shadow> 
                        <Shadow Brush="Maroon" Radius="15"/>
                    </Border.Shadow>

                    <Grid ColumnDefinitions="2*,3*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" >
                        <Label Grid.Row="0" Grid.Column="0" Text="SubTotal" Style="{StaticResource lbl}"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding SubTotal,StringFormat='{0} FCFA'}" TextColor="Black" HorizontalOptions="Center" />

                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0"  Spacing="5">
                            <Label  Text="Tax" VerticalOptions="Center" Style="{StaticResource lbl}"/>
                            <Label  Padding="5,0" BackgroundColor="Wheat" Text="{Binding TaxPercentage,StringFormat='{0}%'}" VerticalOptions="Center"  Style="{StaticResource lbl}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TaxPercentageClickCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding TaxAmount,StringFormat='{0} FCFA'}" TextColor="Black" HorizontalOptions="Center"/>

                        <Border Grid.Row="2" Grid.ColumnSpan="2" Stroke="Maroon" StrokeDashArray="20, 5" StrokeThickness="0.5"/>

                        <Label Grid.Row="3" Grid.Column="0" Text="Total" Style="{StaticResource lbl}"/>
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Total,StringFormat='{0} FCFA'}" TextColor="Black" HorizontalOptions="Center"/>

                        <Border Grid.Row="4" Grid.ColumnSpan="2" Stroke="Maroon" StrokeDashArray="20, 5" StrokeThickness="0.5"/>

                        <Grid Grid.Row="5" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5">
                            <Button Grid.Column="0" BackgroundColor="Red" MinimumHeightRequest="25" MinimumWidthRequest="25" Text="Annuler" Command="{Binding ClearCartCommand}"/>
                            <Button Grid.Column="1" BackgroundColor="Olive" MinimumHeightRequest="25" MinimumWidthRequest="25" Text="Cash" Command="{Binding PlaceOrderCommand}">
                                <Button.CommandParameter>
                                    <x:Boolean>false</x:Boolean>
                                </Button.CommandParameter>
                            </Button>
                            <Button Grid.Column="2" BackgroundColor="Olive" MinimumHeightRequest="25" MinimumWidthRequest="25" Text="En ligne"  Command="{Binding PlaceOrderCommand}">
                                <Button.CommandParameter>
                                    <x:Boolean>true</x:Boolean>
                                </Button.CommandParameter>
                            </Button>
                        </Grid>


                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Grid>

    </Grid>
    
</ContentPage>