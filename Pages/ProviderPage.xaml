<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fastfood.Pages.ProviderPage"
             BackgroundColor="Black"
             Title="ProviderPage">
    <!-- Contenu principal -->
    <Grid RowDefinitions="Auto,*">
        <!-- Section des onglets -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="20,20,20,10" HorizontalOptions="Center">
            <!-- Onglet Commande -->
            <Button Grid.Column="0" 
                    Text="Commande" 
                    BackgroundColor="#800000" 
                    TextColor="White" 
                    CornerRadius="10" 
                    Padding="10,5" 
                    MinimumWidthRequest="80"  />

            <!-- Onglet Fournisseur -->
            <Button Grid.Column="1" 
                    Margin="20,0,0,0"
                    Text="Fournisseur" 
                    BackgroundColor="#E2E2E2" 
                    TextColor="Black" 
                    CornerRadius="10" 
                    Padding="10,5" 
                    MinimumWidthRequest="80"  />
        </Grid>

        <!-- Contenu principal -->
        <ScrollView Grid.Row="1">
            <StackLayout Margin="20" Spacing="15">
                <!-- Conteneur pour le contenu des onglets -->
                <ContentView>
                    <StackLayout>
                        <!-- Conteneur unique -->

                        <!-- Contenu par défaut : Tab Commande -->
                        <StackLayout x:Name="CommandeContent" IsVisible="true">
                            <!-- Formulaire -->
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                
                                <!-- Ligne 1 : Fournisseur et Produit -->
                                <Label Grid.Row="0" Grid.Column="0" Margin="200,0,0,0" TextColor="#800000" Text="Fournisseur" FontAttributes="Bold" />
                                <Entry Grid.Row="1" Grid.Column="0" Margin="200,0,0,0" HorizontalOptions="Start" WidthRequest="200" Placeholder="Nom du fournisseur" BackgroundColor="White" />

                                <Label Grid.Row="0" Grid.Column="1" TextColor="#800000" Text="Produit" FontAttributes="Bold" />
                                <Entry Grid.Row="1" Grid.Column="1"  HorizontalOptions="Start" WidthRequest="200" Placeholder="Nom du produit" BackgroundColor="White" />

                                <!-- Ligne 2 : Date et Quantité -->
                                <Label Grid.Row="2" Margin="200,0,0,0" Grid.Column="0" TextColor="#800000" Text="Date" FontAttributes="Bold" />
                                <DatePicker Grid.Row="3" Margin="200,0,0,0" HorizontalOptions="Start" WidthRequest="200"  TextColor="Black" Grid.Column="0" Format="dd/MM/yyyy"  BackgroundColor="White" />

                                <Label Grid.Row="2" Grid.Column="1" TextColor="#800000" Text="Quantité" FontAttributes="Bold" />
                                <Entry Grid.Row="3" Grid.Column="1" HorizontalOptions="Start" WidthRequest="200" Keyboard="Numeric" Placeholder="Quantité" BackgroundColor="White" />

                                <!-- Ligne 3 : Statut -->
                                <Label Grid.Row="4" Margin="200,0,0,0" Grid.Column="0" TextColor="#800000" Text="Statut" FontAttributes="Bold" />
                                <Picker Grid.Row="5" Grid.Column="0" Margin="200,0,0,0" HorizontalOptions="Start" WidthRequest="200"  Grid.ColumnSpan="2" BackgroundColor="White" />

                                <!-- Bouton Valider -->
                                <Button Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                    Text="Valider"
                                    WidthRequest="100"
                                    BackgroundColor="#800000"
                                    HorizontalOptions="Start"
                                    TextColor="White" 
                                    CornerRadius="10" 
                                    />    
                            </Grid>

                            <!-- Tableau statique des commandes -->
                            <Label Text="Commandes" TextColor="#800000" FontAttributes="Bold" FontSize="Large" Margin="0,20,0,10" />
                            <Grid ColumnDefinitions="3*,2*,2*,2*" RowDefinitions="Auto,*"   BackgroundColor="#E2E2E2" Margin="20,0" >
      
                                <!-- En-tête du tableau -->
                                <Label Grid.Row="0" Grid.Column="0" TextColor="Black" Text="Fournisseur" Padding="10" FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1" TextColor="Black" Text="Date" Padding="10" FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="2" TextColor="Black" Text="Statut" Padding="10" FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="3" TextColor="Black" Text="Actions" Padding="10" FontAttributes="Bold" />

                                <!-- Exemple de ligne de commande -->
                                <Label Grid.Row="1" Grid.Column="0" TextColor="Black" Text="Isaac" Padding="5" BackgroundColor="White" />
                                <Label Grid.Row="1" Grid.Column="1" TextColor="Black" Text="19/10/24" Padding="5" BackgroundColor="White" />
                                <Label Grid.Row="1" Grid.Column="2" TextColor="Black" Text="Livré" Padding="5" BackgroundColor="White" />
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="3" Spacing="10" Padding="5" BackgroundColor="White">
                                    <ImageButton Source="ic_eye_ff.png" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent" />
                                    <ImageButton Source="ic_edit_ff.png" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent" />
                                    <ImageButton Source="ic_trash_ff.png" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent" />
                                </HorizontalStackLayout>
                            </Grid>
                        </StackLayout>

                    </StackLayout>
                </ContentView>

                <!-- Bouton Imprimer -->
                <Button Text="Imprimer" 
                        BackgroundColor="#800000" 
                        TextColor="White" 
                        CornerRadius="10" 
                        HorizontalOptions="End" 
                        Margin="0,20,20,0" />
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>