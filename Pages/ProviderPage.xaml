<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fastfood.Pages.ProviderPage"
             BackgroundColor="WhiteSmoke"
             xmlns:vm="clr-namespace:fastfood.ViewModels"
             xmlns:data="clr-namespace:fastfood.Data"
             xmlns:converters="clr-namespace:fastfood.Converters"
             Shell.NavBarIsVisible="False">

    

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label" x:Key="th">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>

            <Style TargetType="Label" x:Key="td">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="Black"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>

            <Style TargetType="ImageButton" x:Key="actImgBtn">
                <Setter Property="WidthRequest" Value="20"/>
                <Setter Property="HeightRequest" Value="20"/>
                <Setter Property="BackgroundColor" Value="Wheat"/>
                <Setter Property="CornerRadius" Value="10"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Section des onglets -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="20,20,20,10" HorizontalOptions="Center">
            <Button Grid.Column="0" 
                    Text="Fournisseurs" 
                    BackgroundColor="#800000" 
                    TextColor="White" 
                    CornerRadius="10" 
                    Padding="10,5" 
                    MinimumWidthRequest="80"  />

            <Button Grid.Column="1" 
                    Margin="20,0,0,0"
                    Text="Commandes" 
                    BackgroundColor="#E2E2E2" 
                    TextColor="Black" 
                    CornerRadius="10" 
                    Padding="10,5" 
                    MinimumWidthRequest="80" />
        </Grid>

        <!-- Contenu principal -->
        <ScrollView x:Name="MainScrollview" Grid.Row="1">
            <StackLayout Margin="20" Spacing="15">
                <ContentView>
                    <StackLayout>
                        <!-- Formulaire -->
                        <VerticalStackLayout x:Name="FormStackLayout"  VerticalOptions="Center" HorizontalOptions="Center">
                            <Label TextColor="Maroon" HorizontalOptions="Start" Text="Nom" FontAttributes="Bold" />
                            <Entry Text="{Binding SelectedProvider.Name}" HorizontalOptions="Center" WidthRequest="300" Placeholder="Nom du fournisseur" BackgroundColor="White" TextColor="Black" />

                            <Label TextColor="Maroon" HorizontalOptions="Start" Text="Telephone" FontAttributes="Bold" />
                            <Entry Text="{Binding SelectedProvider.PhoneNumber}" HorizontalOptions="Center" WidthRequest="300" Placeholder="Numero" BackgroundColor="White" TextColor="Black" />

                            <Button Text="{Binding IsEditMode, Converter={StaticResource EditModeButtonTextConverter}}" Margin="0,10,0,0" WidthRequest="300" BackgroundColor="Maroon" HorizontalOptions="Center" TextColor="White" 
                                    CornerRadius="10" Command="{Binding SaveProviderCommand}" CommandParameter="{Binding SelectedProvider}" />
                        </VerticalStackLayout>

                        <!-- Liste des fournisseurs -->
                        <Label Text="Fournisseurs" TextColor="#800000" FontAttributes="Bold" FontSize="Large" Margin="0,20,0,10" />

                        <Grid Grid.Column="0" BackgroundColor="White" Padding="15" RowDefinitions="Auto,Auto,*" RowSpacing="15">
                            <Grid Grid.Row="1">
                                <Grid RowDefinitions="30,*">
                                    <Border StrokeShape="RoundRectangle 5" StrokeThickness="0">
                                        <Grid ColumnDefinitions="*,*,*,*" BackgroundColor="Maroon">
                                            <Label Grid.Column="0" Text="Provider Id" Style="{StaticResource th}" Padding="15,0,0,0"/>
                                            <Label Grid.Column="1" Text="Provider Name" Style="{StaticResource th}"/>
                                            <Label Grid.Column="2" Text="Provider PhoneNumber " Style="{StaticResource th}"/>
                                            <Label Grid.Column="3" Text="Actions" Style="{StaticResource th}"/>
                                        </Grid>
                                    </Border>

                                    <CollectionView Grid.Row="1" ItemsSource="{Binding Providers}">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="data:Provider">
                                                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="4,Auto,Auto">
                                                    <Label Grid.Column="0"  Grid.Row="1" Text="{Binding Id ,StringFormat='#{0}'}" Style="{StaticResource td}" Padding="15,0,0,0"/>
                                                    <Label Grid.Column="1"  Grid.Row="1" Text="{Binding Name}" Style="{StaticResource td}" />
                                                    <Label Grid.Column="2"  Grid.Row="1" Text="{Binding PhoneNumber}" Style="{StaticResource td}" />
                                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="3" Spacing="10" Padding="5" BackgroundColor="White">
                                                        <ImageButton Source="ic_edit_ff.png" Style="{StaticResource actImgBtn}"
                                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProvidersViewModel}}, Path=EditProviderCommand}"
                                                             CommandParameter="{Binding .}" />

                                                        <ImageButton Source="ic_trash_ff.png" Style="{StaticResource actImgBtn}"
                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProvidersViewModel}}, Path=DeleteProviderCommand}"
                                                                CommandParameter="{Binding .}"         />
                                                    </HorizontalStackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Grid>
                            </Grid>
                        </Grid>
                    </StackLayout>
                </ContentView>

                <Button Text="Imprimer" BackgroundColor="Maroon" TextColor="White" CornerRadius="10" HorizontalOptions="End" Margin="0,20,20,0" />
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
