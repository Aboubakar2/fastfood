<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fastfood.Pages.ProductsPage"
             Title="ProductsPage">
    <!-- Contenu principal -->
    <Grid RowDefinitions="Auto,*">
        <!-- Section des onglets -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="20,20,20,10" HorizontalOptions="Center">
            <!-- Onglet Commande -->
            <Button Grid.Column="0" 
                 Text="Produits" 
                 BackgroundColor="#800000" 
                 TextColor="White" 
                 CornerRadius="10" 
                 Padding="10,5" 
                 MinimumWidthRequest="80"  />

            <!-- Onglet Fournisseur -->
            <Button Grid.Column="1" 
                 Margin="20,0,0,0"
                 Text="Categories" 
                 BackgroundColor="#E2E2E2" 
                 TextColor="Black" 
                 CornerRadius="10" 
                 Padding="10,5" 
                 MinimumWidthRequest="80"  />
        </Grid>

        <!-- Contenu principal -->
        <ScrollView Grid.Row="1">
            <StackLayout Margin="20" Spacing="15">
                <!-- Conteneur pour le contenu des onglets -->
                <ContentView>
                    <StackLayout>
                        <!-- Conteneur unique -->

                        <!-- Contenu par défaut : Tab Commande -->
                        <StackLayout x:Name="CommandeContent" IsVisible="true">
                            <!-- Formulaire -->
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                                <!-- Ligne 1 :  -->
                                <Label Grid.Row="0" Grid.Column="0" Margin="200,0,0,0" TextColor="#800000" Text="Nom" FontAttributes="Bold" />
                                <Entry Grid.Row="1" Grid.Column="0" Margin="200,0,0,0" HorizontalOptions="Start" WidthRequest="400" Placeholder="Ex: Niébé" BackgroundColor="White" />

                                <Label Grid.Row="0" Grid.Column="1" TextColor="#800000" Text="Qté(Optionnel" FontAttributes="Bold" />
                                <Entry Grid.Row="1" Grid.Column="1"  HorizontalOptions="Start" WidthRequest="400" Placeholder="Nom du produit" BackgroundColor="White" />

                                <!-- Ligne 2 : Date et Quantité -->
                                <Label Grid.Row="2" Margin="200,0,0,0" Grid.Column="0" TextColor="#800000" Text="Catégorie" FontAttributes="Bold" />
                                <Picker Grid.Row="3" Margin="200,0,0,0" HorizontalOptions="Start" WidthRequest="400"  TextColor="Black" Grid.Column="0"   BackgroundColor="White" />

                                <Label Grid.Row="2" Grid.Column="1" TextColor="#800000" Text="Image" FontAttributes="Bold" />
                                <Picker Grid.Row="3" Grid.Column="1" HorizontalOptions="Start" WidthRequest="400"  BackgroundColor="White" />

                                <!-- Ligne 3 : Statut -->
                                <Label Grid.Row="4" Margin="200,0,0,0" Grid.Column="0" TextColor="#800000" Text="Prix" FontAttributes="Bold" />
                                <Picker Grid.Row="5" Grid.Column="0" Margin="200,0,0,0" HorizontalOptions="Start" WidthRequest="400"  Grid.ColumnSpan="2" BackgroundColor="White" />

                                <!-- Bouton Valider -->
                                <Button Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                 Text="Valider"
                                 WidthRequest="100"
                                 BackgroundColor="#800000"
                                 HorizontalOptions="Start"
                                 TextColor="White" 
                                 CornerRadius="10" 
                                 />
                            </Grid>

                            <!-- Tableau statique des commandes -->
                            <Label Text="Commandes" TextColor="#800000" FontAttributes="Bold" FontSize="Large" Margin="0,20,0,10" />
                            <Grid ColumnDefinitions="3*,2*,2*,2*" RowDefinitions="Auto,*"   BackgroundColor="#E2E2E2" Margin="20,0" >

                                <!-- En-tête du tableau -->
                                <Label Grid.Row="0" Grid.Column="0" TextColor="Black" Text="Nom" Padding="10" FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1" TextColor="Black" Text="Catégorie" Padding="10" FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="2" TextColor="Black" Text="Prix" Padding="10" FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="3" TextColor="Black" Text="Actions" Padding="10" FontAttributes="Bold" />

                                <!-- Exemple de ligne de commande -->
                                <!-- Cellule combinant une image arrondie et un label -->
                                <!-- Cellule combinant une image arrondie et un label -->
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" 
                                       Spacing="10" 
                                       Padding="5" 
                                       BackgroundColor="White" 
                                       HorizontalOptions="FillAndExpand" 
                                       VerticalOptions="FillAndExpand">
                                    <!-- Image arrondie -->
                                    <Border
                                        BackgroundColor="LightGray" 
                                        StrokeThickness="1" 
                                        Stroke="Gray" 
                                        HeightRequest="40" 
                                        WidthRequest="40" 
                                        HorizontalOptions="Center" 
                                        VerticalOptions="Center">
                                        <Image 
                                            Source="burger.jpg" 
                                           Aspect="AspectFill" 
                                           HeightRequest="40" 
                                           WidthRequest="40" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" />
                                    </Border>

                                    <!-- Label -->
                                    <Label Text="Niébé" 
                                       TextColor="Black" 
                                       FontSize="14" 
                                       VerticalTextAlignment="Center" 
                                       HorizontalTextAlignment="Start" />
                                </HorizontalStackLayout>
                                <Label Grid.Row="1" Grid.Column="1" TextColor="Black" Text="Menu" Padding="5" BackgroundColor="White" />
                                <Label Grid.Row="1" Grid.Column="2" TextColor="Black" Text="Prix" Padding="5" BackgroundColor="White" />
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="3" Spacing="10" Padding="5" BackgroundColor="White">
                                    <ImageButton Source="ic_eye_ff.png" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent" />
                                    <ImageButton Source="ic_edit_ff.png" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent" />
                                    <ImageButton Source="ic_trash_ff.png" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent" />
                                </HorizontalStackLayout>
                            </Grid>
                        </StackLayout>

                    </StackLayout>
                </ContentView>

                <!-- Bouton Imprimer -->
                <Button Text="Imprimer" 
                     BackgroundColor="#800000" 
                     TextColor="White" 
                     CornerRadius="10" 
                     HorizontalOptions="End" 
                     Margin="0,20,20,0" />
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>