<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fastfood.Pages.ProductsPage"
             BackgroundColor="WhiteSmoke"
            xmlns:vm="clr-namespace:fastfood.ViewModels"
            xmlns:data="clr-namespace:fastfood.Data"
            xmlns:converters="clr-namespace:fastfood.Converters"
            Shell.NavBarIsVisible="False">


    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label" x:Key="th">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>

            <Style TargetType="Label" x:Key="td">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="Black"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>

            <Style TargetType="ImageButton" x:Key="actImgBtn">
                <Setter Property="WidthRequest" Value="20"/>
                <Setter Property="HeightRequest" Value="20"/>
                <Setter Property="BackgroundColor" Value="Wheat"/>
                <Setter Property="CornerRadius" Value="10"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    
    <!-- Contenu principal -->
    <Grid RowDefinitions="Auto,*"  Margin="0,50,0,0">
        <!-- Section des onglets -->
        <!-- <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="20,20,20,10" HorizontalOptions="Center">
           
            <Button Grid.Column="0" 
                 Text="Produits" 
                 BackgroundColor="#800000" 
                 TextColor="White" 
                 CornerRadius="10" 
                 Padding="10,5" 
                 MinimumWidthRequest="80"  />

            <Button Grid.Column="1" 
                 Margin="20,0,0,0"
                 Text="Categories" 
                 BackgroundColor="#E2E2E2" 
                 TextColor="Black" 
                 CornerRadius="10" 
                 Padding="10,5" 
                 MinimumWidthRequest="80"  />
            </Grid> -->

    <!-- Contenu principal -->
        <ScrollView x:Name="MainScrollView" Grid.Row="1">
            <StackLayout Margin="20" Spacing="15">
                <ContentView>
                    <StackLayout>
                        <!-- Formulaire -->
                        <Grid x:Name="FormGridLayout" VerticalOptions="Center" RowDefinitions="*,*,*,*,*,*,*,*,*" ColumnDefinitions="*,*" HorizontalOptions="Center">
                          


                            <!-- Fournisseur (occupe les deux colonnes) -->
                            <Label Grid.Column="0" Grid.ColumnSpan="2" TextColor="Maroon" HorizontalOptions="Center" Text="Fournisseur" FontAttributes="Bold" />
                            <Picker Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding Providers}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                            HorizontalOptions="Center" WidthRequest="300" BackgroundColor="White" TextColor="Black" Margin="20"/>

                            <!-- Nom (première colonne) -->
                            <Label Grid.Row="1" Grid.Column="0" TextColor="Maroon" HorizontalOptions="Start" Text="Nom" FontAttributes="Bold" />
                            <Entry Grid.Row="2" Grid.Column="0"  Text="{Binding SelectedProductOrder.ProductName}" HorizontalOptions="Center" WidthRequest="300" Placeholder="Nom du produit" BackgroundColor="White" TextColor="Black" />

                            <!-- Quantité (deuxième colonne) -->
                            <Label Grid.Row="1" Grid.Column="1" Margin="20,0,0,0" TextColor="Maroon" HorizontalOptions="Start" Text="Quantite" FontAttributes="Bold" />
                            <Entry Grid.Row="2" Grid.Column="1" Margin="20,0,0,0" Text="{Binding SelectedProductOrder.Quantity}" HorizontalOptions="Center" WidthRequest="300" Placeholder="qte" BackgroundColor="White" TextColor="Black" />

                            <!-- Date Commande (première colonne) -->
                            <Label Grid.Row="3" Grid.Column="0" TextColor="Maroon" HorizontalOptions="Start" Text="Date Commande" FontAttributes="Bold" />
                            <DatePicker MinimumDate="01/01/2023"     Grid.Row="4" Grid.Column="0" Date="{Binding SelectedProductOrder.OrderDate,Mode=TwoWay}" HorizontalOptions="Center" WidthRequest="300" BackgroundColor="White" TextColor="Black" />

                            <!-- Prix (deuxième colonne) -->
                            <Label Grid.Row="3" Grid.Column="1" Margin="20,0,0,0" TextColor="Maroon" HorizontalOptions="Start" Text="Prix Unitaire" FontAttributes="Bold" />
                            <Entry Grid.Row="4" Grid.Column="1" Margin="20,0,0,0" Text="{Binding SelectedProductOrder.UnitPrice}" HorizontalOptions="Center" WidthRequest="300" Placeholder="prix" BackgroundColor="White" TextColor="Black" />

                            <!-- Statut (première colonne) -->
                            <Label Grid.Row="5" Grid.Column="0" TextColor="Maroon" HorizontalOptions="Start" Text="Status" FontAttributes="Bold" />
                            <Picker Grid.Row="6" Grid.Column="0"  ItemsSource="{Binding StateOptions}"  
                                SelectedItem="{Binding SelectedProductOrder.State}"
                                HorizontalOptions="Center" WidthRequest="300"  BackgroundColor="White" TextColor="Black" />

                            <!-- Unite de Mesure (deuxieme colonne) -->
                            <Label Grid.Row="5" Grid.Column="1"   Margin="20,0,0,0" TextColor="Maroon" HorizontalOptions="Start" Text="Unite de mesure" FontAttributes="Bold" />
                            <Picker Grid.Row="6" Grid.Column="1" Margin="20,0,0,0"   ItemsSource="{Binding UnitOfMeasureOptions}"  
                             SelectedItem="{Binding SelectedProductOrder.UnitOfMeasure}"
                             HorizontalOptions="Center" WidthRequest="300"  BackgroundColor="White" TextColor="Black" />


                            <!-- Bouton (occupe les deux colonnes) -->
                            <Button Grid.Row="8" Grid.Column="0"  Grid.ColumnSpan="2" Margin="0,20,0,0" Text="{Binding IsEditMode, Converter={StaticResource EditModeButtonTextConverter}}" WidthRequest="300" BackgroundColor="Maroon" HorizontalOptions="Center" TextColor="White"
                                 CornerRadius="10" Command="{Binding SaveProductOrderCommand}" CommandParameter="{Binding SelectedProductOrder}"  />
                        </Grid>



                        <!-- Liste des commandes -->
                        <Label Text="Commandes" TextColor="Maroon" FontAttributes="Bold" FontSize="Large" Margin="0,20,0,10" />

                        <Grid Grid.Column="0" BackgroundColor="White" Padding="15" RowDefinitions="Auto,Auto,*" RowSpacing="15">
                            <Grid Grid.Row="1">
                                <Grid RowDefinitions="30,*">
                                    <Border StrokeShape="RoundRectangle 5" StrokeThickness="0">
                                        <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" BackgroundColor="Maroon">
                                            <Label Grid.Column="0" Text="Id" Style="{StaticResource th}" Padding="15,0,0,0"/>
                                            <Label Grid.Column="1" Text="Nomproduit" Style="{StaticResource th}"/>
                                            <Label Grid.Column="2" Text="Fournisseur" Style="{StaticResource th}"/>
                                            <Label Grid.Column="3" Text="Quantite" Style="{StaticResource th}"/>
                                            <Label Grid.Column="4" Text="DateCommande" Style="{StaticResource th}"/>
                                            <Label Grid.Column="5" Text="PrixUnitaire" Style="{StaticResource th}"/>
                                            <Label Grid.Column="6" Text="UniteMesure" Style="{StaticResource th}"/>
                                            <Label Grid.Column="7" Text="Montat Total" Style="{StaticResource th}"/>
                                            <Label Grid.Column="8" Text="Statut" Style="{StaticResource th}"/>
                                            <Label Grid.Column="9" Text="Actions" Style="{StaticResource th}"/>
                                        </Grid>
                                    </Border>

                                    <CollectionView Grid.Row="1" ItemsSource="{Binding ProductOrders}">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="data:ProductOrder">
                                                <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" RowDefinitions="4,Auto,Auto">
                                                    <Label Grid.Column="0"  Grid.Row="1" Text="{Binding Id ,StringFormat='#{0}'}" Style="{StaticResource td}" Padding="15,0,0,0"/>
                                                    <Label Grid.Column="1"  Grid.Row="1" Text="{Binding ProductName}" Style="{StaticResource td}" />
                                                    <Label Grid.Column="2"  Grid.Row="1" Text="{Binding Provider.Name}" Style="{StaticResource td}" />
                                                    <Label Grid.Column="3"  Grid.Row="1" Text="{Binding Quantity}" Style="{StaticResource td}" />
                                                    <Label Grid.Column="4"  Grid.Row="1" Text="{Binding OrderDate,StringFormat='{0:dd MM yyyy hh:mm}'}" Style="{StaticResource td}" />
                                                    <Label Grid.Column="5"  Grid.Row="1" Text="{Binding UnitPrice}" Style="{StaticResource td}" />
                                                    <Label Grid.Column="6"  Grid.Row="1" Text="{Binding UnitOfMeasure}" Style="{StaticResource td}" />
                                                    <Label Grid.Column="7"  Grid.Row="1" Text="{Binding Amount}" Style="{StaticResource td}" />
                                                    <Label Grid.Column="8"  Grid.Row="1" Text="{Binding State}" Style="{StaticResource td}"  />
                                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="9" Spacing="10" Padding="5" BackgroundColor="White">
                                                        <ImageButton Source="ic_edit_ff.png" Style="{StaticResource actImgBtn}"
                                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductOrderViewModel}}, Path=EditProductOrderCommand}"
                                                             CommandParameter="{Binding .}" />

                                                        <ImageButton Source="ic_trash_ff.png" Style="{StaticResource actImgBtn}"
                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductOrderViewModel}}, Path=DeleteProductOrderCommand}"
                                                                CommandParameter="{Binding .}"  />
                                                    </HorizontalStackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Grid>
                            </Grid>
                        </Grid>
                    </StackLayout>
                </ContentView>

                <Button Text="Imprimer" BackgroundColor="Maroon" TextColor="White" CornerRadius="10" HorizontalOptions="End" Margin="0,20,20,0" />
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
